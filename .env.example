# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32
# Use letters and numbers only for MONGO_PASSWORD (it goes inside a URL).

MONGO_USER=crewcall
MONGO_PASSWORD=change-me-to-a-long-random-hex-string

# 32+ random characters; changing it signs everyone out
JWT_SECRET=change-me-to-a-long-random-hex-string

# The address your crew opens. Invite links and calendar feeds are built from it.
# Behind a Cloudflare Tunnel this is your https hostname, e.g. https://crew.example.org
PUBLIC_URL=http://localhost:8780

# Set to true once PUBLIC_URL is https (keeps the sign-in cookie HTTPS-only)
COOKIE_SECURE=false

# Port on this machine that nginx listens on (point cloudflared here)
WEB_PORT=8780

# Largest single upload in MB (stay under Cloudflare's 100 MB request limit)
MAX_UPLOAD_MB=80

# How long a guest upload link works
GUEST_LINK_HOURS=4

# Email for automatic shift reminders (optional). Gmail example — use an App Password
# (Google Account → Security → App passwords), and %40 for the @ in the address:
#   SMTP_URL=smtps://you%40gmail.com:abcdabcdabcdabcd@smtp.gmail.com:465
#   MAIL_FROM=Church AV Crew <you@gmail.com>
SMTP_URL=
MAIL_FROM=

# Booth Crew Academy sign-in (optional). Crew tap the Academy link and are signed
# in there with their Crew Call account; no second account or password needed.
# Put the SAME secret in the Academy's .env as CREW_CALL_SSO_SECRET.
#   openssl rand -hex 32
ACADEMY_URL=
ACADEMY_SSO_SECRET=
